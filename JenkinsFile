pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                // Checking out the repository
                checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[url: 'https://github.com/devops5014/sample-webapp.git']]
                ])
            }
        }
    }
}
